<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robko01">

    <!-- This will include all the contents of example_include.xacro first. Go check it out! -->
    <xacro:include filename="include.xacro" />

    <!-- This first link called "world" is empty -->
    <link name="world"></link>

    <!-- A simple fixed joint from our empty world link, to our base. -->
    <!-- The base origin is offset from the world origin. -->
    <joint name="base_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="world"/>
        <child link="base_link"/>        
    </joint>
	<link name="base_link">
		<inertial>
			<origin xyz="-0.0685 0.0 0.027" rpy="0.0 0.0 0.0" />
			<mass value="10" />
			<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
		</inertial>
		<visual name="f1">
			<origin xyz="0.0315 0.0635 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/base_foot.STL" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black" />
		</visual>
		<visual name="f2">
			<origin xyz="0.0315 -0.0635 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/base_foot.STL" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black" />
		</visual>
		<visual name="f3">
			<origin xyz="-0.1675 0.0635 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/base_foot.STL" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black" />
		</visual>
		<visual name="f4">
			<origin xyz="-0.1675 -0.0635 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/base_foot.STL" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black" />
		</visual>
		<visual name="base_case">
			<origin  xyz="-0.065 0.0 0.011" rpy="0.0 0.0 0.0"/>
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/base_case.STL" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black" />
		</visual>
		<visual name="base_lid">
			<origin  xyz="-0.065 0.0 0.011" rpy="0.0 0.0 0.0"/>
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/base_lid.STL" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="black" />
		</visual>
	</link>
	<joint name="base" type="revolute">
		<parent link="base_link" />
		<child link="torso_link" />
		<origin xyz="0.0 0.0 0.050" rpy="0.0 0.0 0.0" />
		<axis xyz="0.0 0.0 1.0" />
		<limit upper="${pi/2}" lower="-${pi/2}" velocity="100" effort="100" />
	</joint>
	<link name="torso_link">
		<inertial>
			<origin xyz="-0.0385 0.0 0.0" rpy="0.0 0.0 0.0" />
			<mass value="10" />
			<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
		</inertial>
		<visual name="torso_axis">
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<cylinder radius="0.001" length="0.500"/>
			</geometry>
			<material name="blue"/>
		</visual>
		<visual name="torso_side_left">
			<origin xyz="-0.0415 0.0388 0.0925" rpy="-${pi/2} 0.0 0.0" />
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/torso_side_left.STL" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
		<visual name="torso_bottom">
			<origin xyz="-0.120 0.037 -0.001" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/torso_bottom.STL" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="">
				<color rgba="0.3 0.5 0.3 1.0"/>
			</material>
		</visual>
		<visual name="torso_side_right">
			<origin xyz="0.0 -0.0385 0.100" rpy="${pi/2} 0.0 0.0" />
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/torso_side_right.STL" scale="0.001 0.001 0.001"/>
			</geometry>
