			<geometry>
				<mesh filename="package://robko01_ros2/meshes/axis_06x80.STL" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
		<!-- <visual name="Gear_1M_84T_20PA">
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://robko01_ros2/meshes/Gear_1M_84T_20PA.STL" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="">
				<color rgba="0.3 0.3 0.3 1.0"/>
			</material>
			<material name="silver" />
		</visual> -->
